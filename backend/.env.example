# ─── Flask ──────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# ─── CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── AI / LLM ───────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/
# If left blank, the backend falls back to curated template responses.
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-1.5-flash

# ─── x402 / Algorand ────────────────────────────────────────────────
# Algorand network: "testnet" | "mainnet"
X402_NETWORK=testnet

# Your Algorand receiver address (who gets paid)
X402_RECEIVER_ADDRESS=

# GoPlausible public facilitator (no key needed for testnet)
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Price per workout session in ALGO (e.g. 0.1)
X402_PRICE=0.1

# Asset: "ALGO" or an ASA asset ID (leave ALGO for demo)
X402_ASSET=ALGO

# Algorand node URL for algosdk (public testnet node)
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
