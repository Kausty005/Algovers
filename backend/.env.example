# ─── Flask ───────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# ─── CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── AI / LLM ────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/
# If left blank, backend falls back to template responses (no API needed)
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-1.5-flash

# ─── x402 / Algorand ─────────────────────────────────────────────────
# Algorand network: CAIP-2 identifier
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# Your Algorand TestNet receiver address (who gets paid)
# REQUIRED: Must be set to a real address for TestNet x402
X402_RECEIVER_ADDRESS=

# GoPlausible public facilitator (no key needed for testnet)
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Price per workout session in USDC
X402_PRICE=0.005

# Asset: "ALGO" or an ASA asset ID (10458941 is TestNet USDC)
X402_ASSET=10458941

# Algorand node URLs (public testnet nodes — no key needed)
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
