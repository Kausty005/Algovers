# ─── Flask ───────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# ─── CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── AI / LLM ────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/
# If left blank, backend falls back to template responses (no API needed)
GEMINI_API_KEY=

# Gemini model to use
GEMINI_MODEL=gemini-1.5-flash

# ─── x402 / Algorand ─────────────────────────────────────────────────
# Algorand network: "testnet" | "mainnet"
X402_NETWORK=testnet

# Your Algorand receiver address (who gets paid)
# Leave blank to run in DEMO mode (402 shown but no real chain tx)
X402_RECEIVER_ADDRESS=

# GoPlausible public facilitator (no key needed for testnet)
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Price per workout session in ALGO
X402_PRICE=0.1

# Asset: "ALGO" or an ASA asset ID
X402_ASSET=ALGO

# Algorand node URLs (public testnet nodes — no key needed)
ALGORAND_NODE_URL=https://testnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://testnet-idx.algonode.cloud
